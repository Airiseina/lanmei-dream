# ── 数据库（含 pgvector 扩展）──
DATABASE_URL=postgres://lanmei:lanmei@localhost:5432/lanmei?sslmode=disable

# ── Redis（Conduit 状态存储）──
REDIS_ADDR=localhost:6379

# ── 向量维度（需与 Embedding 模型匹配）──
EMBEDDING_DIM=1024

# ── LLOneBot 通信 ──
WS_URL=ws://127.0.0.1:3001
ACCESS_TOKEN=

# ── 机器人配置 ──
BOT_NICKNAME=蓝妹
SUPER_USERS=

# ── LLM（选一个填，留空则角色扮演不可用）──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── Embedding（选一个填，留空则 RAG 不可用）──
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
