# ── PostgreSQL（含 pgvector 扩展）──
LANMEI_DATABASE_URL=postgres://lanmei:lanmei@localhost:5432/lanmei?sslmode=disable

# ── Redis（Conduit 状态存储）──
LANMEI_REDIS_ADDR=localhost:6379

# ── 网关（反向 WebSocket 服务端，接受 Onebots/NapCat 连接）──
# 监听地址，Docker 内使用 0.0.0.0:8080，本地开发可用 127.0.0.1:8080
LANMEI_BOT_GATEWAY_LISTEN_ADDR=0.0.0.0:8080
# 鉴权 token，Onebots/NapCat 连接时需携带此 token
# 留空则不鉴权（仅建议本地开发使用）
LANMEI_BOT_GATEWAY_ACCESS_TOKEN=

# ── 机器人 ──
LANMEI_BOT_NICKNAME=蓝妹
# 超级用户，格式：platform:userID,逗号分隔
# 示例：qq:123456,wechat:wxid_xxx,napcat:654321
LANMEI_BOT_SUPER_USERS=

# ── LLM（OpenAI 兼容 API，支持 DeepSeek/Qwen/Moonshot/GLM 等）──
# 填入 API Key 后角色扮演和意图分析自动启用
LANMEI_AI_LLM_API_KEY=
LANMEI_AI_LLM_BASE_URL=https://api.openai.com/v1
LANMEI_AI_LLM_MODEL=gpt-4o-mini
LANMEI_AI_LLM_MAX_TOKENS=4096
LANMEI_AI_LLM_TEMPERATURE=0.7

# ── Embedding（OpenAI 兼容 API）──
# 填入 API Key 后 RAG 向量检索自动启用
LANMEI_AI_EMBEDDING_API_KEY=
LANMEI_AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
LANMEI_AI_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度（需与 Embedding 模型匹配，text-embedding-3-small=1536）
LANMEI_AI_EMBEDDING_DIM=1536

# ── 网易云点歌插件 ──
# 网易云音乐 API 服务地址（ncm-api，如 moefurina/ncm-api 镜像）。
# 为空时 /music 点歌功能不可用
LANMEI_PLUGIN_NCM_URL=

# ── PostgreSQL 容器 ──
# POSTGRES_USER=lanmei
# POSTGRES_PASSWORD=lanmei
# POSTGRES_DB=lanmei
# POSTGRES_PORT=5432

# ── Redis 容器 ──
# REDIS_PORT=6379

# ── 蓝妹服务端口映射（主机端口:容器端口）──
# LANMEI_PORT=8080

# ── 管理面板前端（nginx 托管，manager-web 服务）──
# 统一入口端口：http://<host>:${MANAGER_WEB_PORT} 托管前端并反代 /api
# 启用管理面板需在 .env 提供（密钥不落盘，仅环境变量）：
LANMEI_MANAGER_ADMIN_USERNAME=admin         # 超级管理员用户名
LANMEI_MANAGER_ADMIN_PASSWORD=lanmei_admin  # 超级管理员密码（最少8位）
LANMEI_MANAGER_SECRET_KEY=d5e9ca24a98f9b021e1821c789d6f005  # JWT派生密钥（最少32位）
# 可选（WebAuthn passkey 需要域名 + HTTPS，通过 nginx 域名访问时配置 RPID；
# webauthn_origins 数组请直接在 config/config.toml 的 [manager] 中配置）：
#   LANMEI_MANAGER_WEBAUTHN_RPID=lanmei.example.com
# MANAGER_WEB_PORT=80

# ── 知识库系统 ──
# 总开关（需与 config.toml 的 [knowledge] 配合）
LANMEI_KNOWLEDGE_ENABLED=true
# 每轮对话隐式召回注入的条数
LANMEI_KNOWLEDGE_AUTO_RECALL_LIMIT=3
# 飞书知识库凭据（provider = "feishu" 时使用）
# 需在飞书开放平台为企业自建应用开通 Wiki 与文档读取权限，
# 并将应用添加为目标知识空间的成员（管理员）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
